{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Server": {
    "Url": "http://0.0.0.0:5000"
  },
  "AllowedHosts": "*",
  "OfficeToPdfModuleOptions": {
    "IsEnabled": true,
    "TempPath": "/tmp/office-to-pdf",
    "OfficeProvider": "LibreOffice",
    "LibreOffice": {
      "ExecutablePath": "/usr/bin/soffice",
      "Timeout": "00:05:00",
      "ProcessPoolSize": 5
    }
  },
  "OfficeToPdfSdkHostingModuleOptions": {
    "SocketPath": "/tmp/office-to-pdf.sock"
  }
}
