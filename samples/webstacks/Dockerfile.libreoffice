# Pre-built base image with LibreOffice pre-installed
# This image is used as a base for the conversion service to reduce build time
FROM mcr.microsoft.com/dotnet/aspnet:10.0

# Install Office (LibreOffice) for Linux
RUN apt-get update && \
    apt-get install -y \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    && rm -rf /var/lib/apt/lists/*

# Set labels for tracking
LABEL maintainer="FelixELabs.OfficeToPdfSdk Team"
LABEL description="Base image with .NET 10.0 aspnet runtime and LibreOffice"
