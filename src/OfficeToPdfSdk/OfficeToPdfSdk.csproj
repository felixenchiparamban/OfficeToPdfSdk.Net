<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>$(Company).$(MSBuildProjectName)</RootNamespace>
    <PackageId>OfficeToPdfSdk</PackageId>
    <Description>A .NET SDK for converting Office documents (Word, Excel, PowerPoint) to PDF with cross-platform support via LibreOffice and Microsoft Office providers.</Description>
    <PackageTags>pdf;office;word;excel;powerpoint;conversion;libreoffice;dotnet</PackageTags>
    <!-- Suppress NU1701 warning for Office Interop packages that only support .NET Framework -->
    <!-- These packages are embedded and work correctly despite the compatibility warning -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
  </ItemGroup>

</Project>
