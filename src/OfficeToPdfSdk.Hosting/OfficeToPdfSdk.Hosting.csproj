<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>$(Company).$(MSBuildProjectName)</RootNamespace>
    <PackageId>OfficeToPdfSdk.Hosting</PackageId>
    <Description>Shared hosting abstractions for OfficeToPdfSdk — IConversionServer interface, background service infrastructure, and file I/O abstractions for building cross-platform conversion servers.</Description>
    <PackageTags>pdf;office;conversion;hosting;ipc;server;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfficeToPdfSdk\OfficeToPdfSdk.csproj" />
  </ItemGroup>

</Project>
